# ============================================================
# ORIGEM VINHOS — Template de Configuração de Ambiente
# ============================================================
# Instruções: Copie este arquivo para .env e preencha suas chaves:
# cp .env.example .env

# Banco de Dados PostgreSQL (Local via Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/origemvinhos

# Porta do Servidor Web
PORT=3000

# Chave Secreta para Assinatura de Sessões/Cookies (mínimo 32 caracteres)
SESSION_SECRET=coloque_uma_chave_secreta_aleatoria_aqui_com_pelo_menos_32_caracteres

# Provedor de Pagamento (mock para desenvolvimento ou mercadopago para produção)
PAYMENT_GATEWAY=mock
# MP_ACCESS_TOKEN=seu_access_token_mercado_pago_aqui
# MP_WEBHOOK_SECRET=seu_webhook_secret_aqui

# Google Gemini AI (RAG, Embeddings & Sommelier Virtual)
# Obtenha sua chave gratuita em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3-flash-preview

# OpenRouter AI (Fallback automático opcional para o Sommelier)
# Obtenha sua chave em: https://openrouter.ai/
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
OPENROUTER_MODEL=openrouter/free
